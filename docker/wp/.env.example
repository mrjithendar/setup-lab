# Non-secret example variables only; do not add passwords here.
# Optional usage from the repository root:
#   source wp/.env.example
#   sudo bash install.sh "$DOMAIN" "$AWS_REGION" "$WORDPRESS_ADMIN_EMAIL" "$WORDPRESS_ADMIN_USER"
# install.sh requires DOMAIN as its first argument; it has no default domain.
# Compose does not load this file or .env. Passwords come from AWS at runtime.
DOMAIN=example.com
AWS_REGION=us-east-1
WORDPRESS_ADMIN_EMAIL=you@example.com
WORDPRESS_ADMIN_USER=siteadmin
