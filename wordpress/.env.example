# Copy this file to .env in the wordpress/ directory and fill in strong, unique values.
# docker compose automatically loads .env from the compose project directory.
# .env is gitignored and must NEVER be committed.

# MySQL / WordPress database credentials
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser
MYSQL_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# WordPress must use the same DB user/password as above
WORDPRESS_DB_USER=wpuser
WORDPRESS_DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
WORDPRESS_DB_NAME=wordpress
