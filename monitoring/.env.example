# Copy this file to .env in the monitoring/ directory and fill in strong values.
# docker compose automatically loads .env from the compose project directory.
# .env is gitignored and must NEVER be committed.

# Grafana admin credentials (defaults to admin/admin if unset — do NOT leave unset)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD
