discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // Clean container name
  rule {
    target_label = "container"
    replacement  = "${__meta_docker_container_name}"
  }

  // Docker compose service (very useful)
  rule {
    target_label = "compose_service"
    replacement  = "${__meta_docker_container_label_com_docker_compose_service}"
  }

  // Docker image
  rule {
    target_label = "image"
    replacement  = "${__meta_docker_container_image}"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.write.local_loki.receiver]
}

loki.write "local_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
