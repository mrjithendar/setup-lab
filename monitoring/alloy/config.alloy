// --- LOGGING & TRACING ---

logging {
  level  = "info"
  format = "json"
}

tracing {
  sampling_fraction = 1.0
  write_to          = [otelcol.exporter.otlp.tempo.input]
}

// --- EXPORT / WRITE CONFIGURATION ---

prometheus.remote_write "prometheus" {
  endpoint {
    url = "http://prometheus:9090/prometheus/api/v1/write"
  }
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure             = true
      insecure_skip_verify = true
    }
  }
}

// --- DISCOVERY & RELABELING ---

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Relabeling for LOGS (Broad)
discovery.relabel "logs_filter" {
  targets = discovery.docker.containers.targets

  // Drop Alloy logs
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/alloy"
    action        = "drop"
  }

  // Service label
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "service"
  }
}

// Relabeling for METRICS
discovery.relabel "metrics_filter" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

// --- LOG COLLECTION ---

// ✅ Docker container logs
loki.source.docker "docker_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.logs_filter.output
  forward_to = [loki.write.loki.receiver]
}

// ✅ File-based logs: /var/log/*.log
local.file_match "varlogs" {
  path_targets = [
    { "__path__" = "/var/log/*.log" }
  ]
  sync_period = "5s"
}

loki.source.file "varlog_files" {
  targets       = local.file_match.varlogs.targets
  tail_from_end = true

  labels = {
    job  = "varlogs"
    host = "${HOSTNAME}"
  }

  forward_to = [loki.write.loki.receiver]
}

// ✅ Journald logs: /var/log/journal
loki.source.journal "systemd" {
  path = "/var/log/journal"

  labels = {
    job  = "systemd"
    host = "${HOSTNAME}"
  }

  forward_to = [loki.write.loki.receiver]
}

// --- METRIC COLLECTION ---

prometheus.exporter.unix "local_system" {
  procfs_path  = "/host/proc"
  sysfs_path   = "/host/sys"
  rootfs_path  = "/host/root"
}

prometheus.scrape "node_metrics" {
  targets    = prometheus.exporter.unix.local_system.targets
  forward_to = [prometheus.remote_write.prometheus.receiver]
}

prometheus.exporter.cadvisor "all_containers" {
  docker_only = true
}

prometheus.scrape "cadvisor" {
  targets    = prometheus.exporter.cadvisor.all_containers.targets
  forward_to = [prometheus.remote_write.prometheus.receiver]
}

prometheus.scrape "metrics_collector" {
  targets    = discovery.relabel.metrics_filter.output
  forward_to = [prometheus.remote_write.prometheus.receiver]
}
