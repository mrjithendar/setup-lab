logging {
  level = "info"
}

// Docker discovery
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Relabel Docker metadata
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    target_label = "container"
    replacement  = "${__meta_docker_container_name}"
  }

  rule {
    target_label = "image"
    replacement  = "${__meta_docker_container_image}"
  }

  rule {
    target_label = "service"
    replacement  = "${__meta_docker_container_name}"
  }

  rule {
    target_label = "job"
    replacement  = "docker"
  }
}