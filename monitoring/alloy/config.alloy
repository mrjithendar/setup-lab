logging {
  level    = "debug"
  format   = "json"
  write_to = [loki.write.loki.receiver]
}

// prometheus writer configuration
prometheus.remote_write "prometheus" {
  endpoint {
    url = "http://prometheus:9090/prometheus/api/v1/write"
  }
}

// loki writer configuration
loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// tempo writer configuration
otelcol.exporter.otlp "tempo" {
    client {
      endpoint = "tempo:4317"
    }
    tls {
      insecure = true
    }
}

// dicover docker containers for log processing
discovery.docker "docker_containers" {
  host = "unix:///var/run/docker.sock"
}

loki.source.docker "docker_logs" {
  host    = "unix:///var/run/docker.sock"
  targets = discovery.relabel.log_processing.output
  forward_to = [loki.write.loki.receiver]
}

// scrape metrics and send to prometheus
prometheus.scrape "metrics_collector" {
  targets = discovery.docker.docker_containers.targets
  forward_to = [prometheus.remote_write.prometheus.receiver]
}

// tracing configuration
tracing {
  sampling_fraction = 0.1
  write_to          = [otelcol.exporter.otlp.otlp_exporter.input]
}



otelcol.exporter.prometheus "to_prometheus" {
  forward_to = [prometheus.remote_write.prometheus.receiver]
}

otelcol.exporter.loki "to_loki" {
  forward_to = [loki.write.loki.receiver]
}

otelcol.exporter.loki "to_tempo" {
  forward_to = [loki.write.tempo.receiver]
}

otelcol.receiver.otlp "otlp_receiver" {
  // OpenTelemetry Protocol (OTLP) receiver configuration (from Alloy)
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  // HTTP receiver configuration (from Alloy)
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = [otelcol.exporter.prometheus.to_prometheus.input]
    logs    = [otelcol.exporter.loki.to_loki.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

// var logs processing
local.file_match "varlogs" {
  path_targets = [
    {
      "__path__" = "/var/log/*.log",
      },
    ]
  sync_period = "5s"
}

loki.source.file "log_scrape" {
  targets    = local.file_match.varlogs.targets
  forward_to = [loki.process.filter_logs.receiver]
  tail_from_end = true
}

loki.process "filter_logs" {
  forward_to = [loki.write.loki.receiver]
}