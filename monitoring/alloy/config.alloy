logging {
  level = "debug"
  format = "logfmt"
}

// 1. Discover Docker containers
discovery.docker "linux_containers" {
  host = "unix:///var/run/docker.sock"
}

// 2. Collect logs from the discovered targets
loki.source.docker "docker_logs" {
  host    = "unix:///var/run/docker.sock"
  targets = discovery.docker.linux_containers.targets
  
  // Forward logs to the loki.write component defined below
  forward_to = [loki.write.local_loki.receiver]
}

// 3. Write logs to Loki
loki.write "local_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
    
    // Optional: Add basic auth if your Loki instance requires it
    // basic_auth {
    //   username = "your_username"
    //   password = "your_password"
    // }
  }
}