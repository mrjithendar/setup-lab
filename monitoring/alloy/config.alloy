// --- LOGGING & TRACING ---

logging {
  level  = "info"
  format = "json"
}

tracing {
  sampling_fraction = 1.0
  write_to          = [otelcol.exporter.otlp.tempo.input]
}

// --- EXPORT / WRITE CONFIGURATION ---

prometheus.remote_write "prometheus" {
  endpoint {
    url = "http://prometheus:9090/prometheus/api/v1/write"
  }
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure             = true
      insecure_skip_verify = true
    }
  }
}

// --- DISCOVERY & RELABELING ---

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Relabeling for LOGS (Broad: keep almost everything)
discovery.relabel "logs_filter" {
  targets = discovery.docker.containers.targets

  // Rule: Drop Alloy's own logs to avoid infinite loops
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/alloy"
    action        = "drop"
  }

  // Rule: Format service name
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "service"
  }
}

// Relabeling for METRICS (Strict: Only containers with scrape label)
discovery.relabel "metrics_filter" {
  targets = discovery.docker.containers.targets

  // Only scrape containers with label: prometheus.io/scrape=true
  // rule {
  //   source_labels = ["__meta_docker_container_label_prometheus_io_scrape"]
  //   regex         = "true"
  //   action        = "keep"
  // }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

// --- LOG COLLECTION ---

loki.source.docker "docker_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.logs_filter.output
  forward_to = [loki.write.loki.receiver]
}

local.file_match "varlogs" {
  path_targets = [{ "__path__" = "/var/log/*.log" }]
  sync_period  = "5s"
}

loki.source.file "log_scrape" {
  targets       = local.file_match.varlogs.targets
  forward_to    = [loki.write.loki.receiver]
  tail_from_end = true
}

// --- METRIC COLLECTION ---

// Scrape internal exporters
prometheus.exporter.unix "local_system" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/root"
}

prometheus.scrape "node_metrics" {
  targets    = prometheus.exporter.unix.local_system.targets
  forward_to = [prometheus.remote_write.prometheus.receiver]
}

prometheus.exporter.cadvisor "all_containers" {
  docker_only = true
}

prometheus.scrape "cadvisor" {
  targets    = prometheus.exporter.cadvisor.all_containers.targets
  forward_to = [prometheus.remote_write.prometheus.receiver]
}

// Scrape labeled application containers
prometheus.scrape "metrics_collector" {
  targets    = discovery.relabel.metrics_filter.output
  forward_to = [prometheus.remote_write.prometheus.receiver]
}