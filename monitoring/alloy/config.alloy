logging {
  level = "info"
}

// Docker discovery
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Relabel Docker metadata
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    target_label = "container"
    replacement  = "${__meta_docker_container_name}"
  }

  rule {
    target_label = "image"
    replacement  = "${__meta_docker_container_image}"
  }

  rule {
    target_label = "service"
    replacement  = "${__meta_docker_container_name}"
  }

  rule {
    target_label = "job"
    replacement  = "docker"
  }
}

// LOGS → Loki
loki.source.docker "logs" {
  targets = discovery.relabel.containers.output
  forward_to = [loki.process.logs.receiver]
}

loki.process "logs" {
  stage.static_labels {
    values = {
      env = "vultr-vm"
      host = "jithendar"
    }
  }

  stage.labels {
    values = ["container", "service", "image"]
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}