logging {
  level  = "info"
  format = "logfmt"
}

//
// ==========================
// Remote write → Prometheus
// ==========================
prometheus.remote_write "local_prometheus" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

//
// ==========================
// Alloy self-metrics
// ==========================
prometheus.scrape "alloy_self" {
  targets = [
    {
      __address__ = "alloy:12345",
      job         = "alloy",
      instance    = constants.hostname,
    },
  ]

  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.local_prometheus.receiver]
}

//
// ==========================
// Docker / cAdvisor metrics
// ==========================
prometheus.exporter.cadvisor "docker" {
  docker_only = true
}

discovery.relabel "docker" {
  targets = prometheus.exporter.cadvisor.docker.targets

  rule {
    target_label = "job"
    replacement  = "docker"
  }

  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
}

prometheus.scrape "docker" {
  targets         = discovery.relabel.docker.output
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.local_prometheus.receiver]
}

//
// ==========================
// Redis metrics
// ==========================
prometheus.exporter.redis "redis" {
  address = "redis:6379"
}

prometheus.scrape "redis" {
  targets = prometheus.exporter.redis.redis.targets
  forward_to = [prometheus.remote_write.local_prometheus.receiver]
}

//
// ==========================
// MySQL metrics
// ==========================
prometheus.exporter.mysql "mysql" {
  data_source_name = "exporter:password@(mysql:3306)/"
}

prometheus.scrape "mysql" {
  targets    = prometheus.exporter.mysql.mysql.targets
  forward_to = [prometheus.remote_write.local_prometheus.receiver]
}
