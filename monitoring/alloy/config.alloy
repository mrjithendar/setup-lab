// 1. METRICS SECTION
// Host-level metrics (CPU, RAM, Disk)
prometheus.exporter.unix "host_stats" {
  procfs_path = "/proc"
  sysfs_path  = "/sys"
}

// Container-level metrics (cAdvisor)
prometheus.exporter.cadvisor "all_containers" {
  docker_only = true
}

// Scrape and ship all metrics
prometheus.scrape "metrics_collector" {
  targets = concat(
    prometheus.exporter.unix.host_stats.targets,
    prometheus.exporter.cadvisor.all_containers.targets,
  )
  forward_to = [prometheus.remote_write.prom_server.receiver]
  
  scrape_interval = "15s"
}

// Prometheus Write Endpoint
prometheus.remote_write "prom_server" {
  endpoint {
    url = "http://prometheus:9090/prometheus/api/v1/write"
    // Uncomment for Basic Auth
    // basic_auth {
    //   username = "admin"
    //   password = "password"
    // }
  }
}

// 2. LOGS SECTION
// Discover all containers on the host
discovery.docker "all_containers" {
  host = "unix:///var/run/docker.sock"
}

// Standardize labels and filter noise
discovery.relabel "log_processing" {
  targets = discovery.docker.all_containers.targets

  // Drop Alloy's own logs to prevent infinite loops
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/alloy"
    action        = "drop"
  }

  // Create 'service' label from container name (strip leading /)
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "service"
  }

  // Keep the image name for debugging
  rule {
    source_labels = ["__meta_docker_container_image"]
    target_label  = "image"
  }
}

// Collect the logs
loki.source.docker "docker_logs" {
  host    = "unix:///var/run/docker.sock"
  targets = discovery.relabel.log_processing.output
  forward_to = [loki.write.loki_server.receiver]
}

// Loki Write Endpoint
loki.write "loki_server" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}