discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // Container name
  rule {
    target_label = "container"
    replacement  = "${__meta_docker_container_name}"
  }

  // Docker Compose service
  rule {
    target_label = "service"
    replacement  = "${__meta_docker_container_label_com_docker_compose_service}"
  }

  // Docker Compose project
  rule {
    target_label = "project"
    replacement  = "${__meta_docker_container_label_com_docker_compose_project}"
  }

  // Image name
  rule {
    target_label = "image"
    replacement  = "${__meta_docker_container_image}"
  }

  // Host
  rule {
    target_label = "host"
    replacement  = constants.hostname
  }
}

logging {
  level  = "debug"
  format = "logfmt"
}