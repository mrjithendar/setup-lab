// ------------------------------------
// Docker discovery (MUST come first)
// ------------------------------------
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// ------------------------------------
// Relabel discovered containers
// ------------------------------------
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    target_label = "container"
    replacement  = "${__meta_docker_container_name}"
  }

  rule {
    target_label = "service"
    replacement  = "${__meta_docker_container_label_com_docker_compose_service}"
  }

  rule {
    target_label = "project"
    replacement  = "${__meta_docker_container_label_com_docker_compose_project}"
  }

  rule {
    target_label = "host"
    replacement  = constants.hostname
  }
}

// ------------------------------------
// Read Docker logs
// ------------------------------------
loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.write.local_loki.receiver]
}

// ------------------------------------
// Push logs to Loki
// ------------------------------------
loki.write "local_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
